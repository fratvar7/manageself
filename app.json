{
  "expo": {
    "name": "Vitacore",
    "slug": "vitacore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Vitacore-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "vitacore",
    "splash": {
      "image": "./assets/Vitacore-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Vitacore-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.frjrv.vitacore"
    },
    "web": {
      "favicon": "./assets/Vitacore-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "28856992-0ee9-46ca-904d-6e282093f133"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
